# Copy to .env and fill in.  cp .env.example .env

# Signs the auth cookie — set to a long random string. Generate with:  openssl rand -hex 32
RECALL_SECRET=change-me-to-a-long-random-string

# Optional — S3 backup via Litestream. Leave blank to skip backups (e.g. Pi local-only).
LITESTREAM_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
